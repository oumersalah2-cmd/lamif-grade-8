# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=lamif_kutaa_8

# Database Connection URL (used by Prisma)
DATABASE_URL="postgresql://postgres:replace_with_strong_password_in_production@postgres:5432/lamif_kutaa_8?schema=public&connection_limit=20"

# Security & Token Settings
JWT_SECRET="replace_with_strong_64char_jwt_secret_in_production"
JWT_REFRESH_SECRET="replace_with_strong_64char_refresh_secret_in_production"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="90d"
ADMIN_SECRET="replace_with_super_secure_admin_secret"

# Offline Rules
OFFLINE_GRACE_DAYS=21

# SMS Configuration (Zero cost by default; swappable provider)
REQUIRE_PHONE_OTP_AT_SIGNUP=false
SMS_PROVIDER=mock # Options: mock, http, ethio_telecom, africastalking
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="LAMIF"

# Application Settings
NODE_ENV=production
PORT=5000
BASE_URL="https://api.lamif.org"
CORS_ORIGIN="*"

# Public Domain & SSL Settings
DOMAIN_NAME="api.lamif.org"
CERTBOT_EMAIL="admin@lamif.org"
